{"openapi":"3.1.0","info":{"title":"Rumi Notification Service API","description":"REST API of the Alerts & Notification bounded context: alerts raised by seismic risk (US14, US16) or by sensor readings that exceed a threshold (US15), and the thresholds of each sensor.","version":"0.2.0"},"servers":[{"url":"http://localhost:8085","description":"Generated server url"}],"tags":[{"name":"Health","description":"Liveness of the service skeleton"},{"name":"Thresholds","description":"Alert limits of each sensor; only administrators reach them through the gateway"},{"name":"Alerts","description":"Alerts raised by seismic risk or by sensor readings that exceed a threshold"}],"paths":{"/api/v1/thresholds/{sensorId}":{"get":{"tags":["Thresholds"],"summary":"Get the threshold of a sensor","description":"Returns the alert limits of the sensor (US15).","operationId":"getThreshold","parameters":[{"name":"sensorId","in":"path","description":"Identifier of the sensor","required":true,"schema":{"type":"string","format":"uuid"},"example":"5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11"}],"responses":{"200":{"description":"Threshold of the sensor","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ThresholdResponse"},"examples":{"Configured threshold":{"description":"Configured threshold","value":{"sensorId":"5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11","buildingId":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d","warningValue":0.05,"criticalValue":0.1,"updatedAt":"2026-10-30T15:00:00Z"}}}}}},"404":{"description":"The sensor has no threshold","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"No threshold":{"description":"No threshold","value":{"type":"about:blank","title":"Not Found","status":404,"detail":"Sensor 5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11 has no threshold","instance":"/api/v1/thresholds/5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11"}}}}}}}},"put":{"tags":["Thresholds"],"summary":"Configure the threshold of a sensor","description":"Creates the threshold of the sensor or changes its limits (US15). A reading at or above the warning value raises a HIGH alert; at or above the critical value, a CRITICAL alert. The warning value must be lower than the critical value.","operationId":"configureThreshold","parameters":[{"name":"sensorId","in":"path","description":"Identifier of the sensor","required":true,"schema":{"type":"string","format":"uuid"},"example":"5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11"}],"requestBody":{"description":"Building of the sensor and its limits","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ThresholdRequest"},"examples":{"Vibration limits":{"description":"Vibration limits","value":{"buildingId":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d","warningValue":0.05,"criticalValue":0.1}}}}},"required":true},"responses":{"200":{"description":"Threshold created or updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ThresholdResponse"},"examples":{"Configured threshold":{"description":"Configured threshold","value":{"sensorId":"5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11","buildingId":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d","warningValue":0.05,"criticalValue":0.1,"updatedAt":"2026-10-30T15:00:00Z"}}}}}},"400":{"description":"A field is missing or not positive, the warning value is not lower than the critical value, the sensor belongs to another building, or sensorId is not a valid UUID","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"Negative value":{"description":"Negative value","value":{"type":"about:blank","title":"Bad Request","status":400,"detail":"Invalid request content.","instance":"/api/v1/thresholds/5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11","errors":{"warningValue":"must be greater than 0"}}},"Warning above critical":{"description":"Warning above critical","value":{"type":"about:blank","title":"Bad Request","status":400,"detail":"Warning value must be lower than the critical value","instance":"/api/v1/thresholds/5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11"}}}}}}}}},"/api/v1/alerts/{alertId}/resolve":{"patch":{"tags":["Alerts"],"summary":"Resolve an alert","description":"Closes an OPEN or ACKNOWLEDGED alert when no further action is needed. A resolved threshold alert lets the sensor raise a new one.","operationId":"resolveAlert","parameters":[{"name":"alertId","in":"path","description":"Identifier of the alert","required":true,"schema":{"type":"string","format":"uuid"},"example":"0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a"}],"responses":{"200":{"description":"Alert resolved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AlertResponse"},"examples":{"Resolved alert":{"description":"Resolved alert","value":{"id":"0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a","buildingId":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d","type":"SEISMIC_RISK","severity":"MEDIUM","status":"RESOLVED","title":"Seismic risk MEDIUM","message":"Medium structural risk after the seismic event. A structural inspection of the affected zones is recommended.","evacuationRequired":false,"riskIndexId":"3c9a1e7d-4b2f-4d8e-a6c1-7e5f3b2d1a90","seismicEventId":"9e8d7c6b-5a4f-4e3d-b2c1-0a9f8e7d6c5b","sensorId":null,"zone":null,"measuredValue":null,"occurredAt":"2026-10-06T14:32:00Z","createdAt":"2026-10-06T14:32:00Z","acknowledgedAt":"2026-10-30T15:20:00Z","acknowledgedBy":"c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f","resolvedAt":"2026-10-30T16:05:00Z"}}}}}},"404":{"description":"No alert has that identifier","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"Unknown alert":{"description":"Unknown alert","value":{"type":"about:blank","title":"Not Found","status":404,"detail":"Alert 0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a was not found","instance":"/api/v1/alerts/0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a"}}}}}},"409":{"description":"The alert is already RESOLVED","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"Already resolved":{"description":"Already resolved","value":{"type":"about:blank","title":"Conflict","status":409,"detail":"Alert 0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a is already RESOLVED","instance":"/api/v1/alerts/0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a/resolve"}}}}}}}}},"/api/v1/alerts/{alertId}/acknowledge":{"patch":{"tags":["Alerts"],"summary":"Acknowledge an alert","description":"Records that the administrator has seen an OPEN alert. The user comes from the X-User-Id header added by the gateway.","operationId":"acknowledgeAlert","parameters":[{"name":"alertId","in":"path","description":"Identifier of the alert","required":true,"schema":{"type":"string","format":"uuid"},"example":"0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a"}],"responses":{"200":{"description":"Alert acknowledged","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AlertResponse"},"examples":{"Acknowledged alert":{"description":"Acknowledged alert","value":{"id":"0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a","buildingId":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d","type":"SEISMIC_RISK","severity":"MEDIUM","status":"ACKNOWLEDGED","title":"Seismic risk MEDIUM","message":"Medium structural risk after the seismic event. A structural inspection of the affected zones is recommended.","evacuationRequired":false,"riskIndexId":"3c9a1e7d-4b2f-4d8e-a6c1-7e5f3b2d1a90","seismicEventId":"9e8d7c6b-5a4f-4e3d-b2c1-0a9f8e7d6c5b","sensorId":null,"zone":null,"measuredValue":null,"occurredAt":"2026-10-06T14:32:00Z","createdAt":"2026-10-06T14:32:00Z","acknowledgedAt":"2026-10-30T15:20:00Z","acknowledgedBy":"c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f","resolvedAt":null}}}}}},"404":{"description":"No alert has that identifier","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"Unknown alert":{"description":"Unknown alert","value":{"type":"about:blank","title":"Not Found","status":404,"detail":"Alert 0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a was not found","instance":"/api/v1/alerts/0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a"}}}}}},"409":{"description":"The alert is not OPEN","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"Already acknowledged":{"description":"Already acknowledged","value":{"type":"about:blank","title":"Conflict","status":409,"detail":"Alert 0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a is ACKNOWLEDGED and cannot be acknowledged","instance":"/api/v1/alerts/0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a/acknowledge"}}}}}}}}},"/api/v1/thresholds":{"get":{"tags":["Thresholds"],"summary":"List the thresholds of a building","description":"Returns the thresholds of the sensors of the building (US15). The list is empty when no sensor has a threshold yet.","operationId":"listThresholds","parameters":[{"name":"buildingId","in":"query","description":"Identifier of the building","required":true,"schema":{"type":"string","format":"uuid"},"example":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d"}],"responses":{"200":{"description":"Thresholds of the building (possibly none)","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ThresholdResponse"}},"examples":{"One threshold":{"description":"One threshold","value":[{"sensorId":"5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11","buildingId":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d","warningValue":0.05,"criticalValue":0.1,"updatedAt":"2026-10-30T15:00:00Z"}]}}}}},"400":{"description":"buildingId is missing or is not a valid UUID","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}}},"/api/v1/alerts":{"get":{"tags":["Alerts"],"summary":"List the alerts of a building","description":"Returns the alerts of the building, newest first (US14, US15, US16). Filter by status to get, for example, only the OPEN alerts. Through the gateway, a RESIDENT only sees the alerts of the buildings in their token.","operationId":"listAlerts","parameters":[{"name":"buildingId","in":"query","description":"Identifier of the building","required":true,"schema":{"type":"string","format":"uuid"},"example":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d"},{"name":"status","in":"query","description":"Only alerts with this status","required":false,"schema":{"type":"string","enum":["OPEN","ACKNOWLEDGED","RESOLVED"]},"example":"OPEN"}],"responses":{"200":{"description":"Alerts of the building (possibly none)","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AlertResponse"}},"examples":{"One open alert":{"description":"One open alert","value":[{"id":"0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a","buildingId":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d","type":"SEISMIC_RISK","severity":"MEDIUM","status":"OPEN","title":"Seismic risk MEDIUM","message":"Medium structural risk after the seismic event. A structural inspection of the affected zones is recommended.","evacuationRequired":false,"riskIndexId":"3c9a1e7d-4b2f-4d8e-a6c1-7e5f3b2d1a90","seismicEventId":"9e8d7c6b-5a4f-4e3d-b2c1-0a9f8e7d6c5b","sensorId":null,"zone":null,"measuredValue":null,"occurredAt":"2026-10-06T14:32:00Z","createdAt":"2026-10-06T14:32:00Z","acknowledgedAt":null,"acknowledgedBy":null,"resolvedAt":null}]}}}}},"400":{"description":"buildingId is missing or is not a valid UUID, or status is not OPEN, ACKNOWLEDGED or RESOLVED","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"Missing building id":{"description":"Missing building id","value":{"type":"about:blank","title":"Bad Request","status":400,"detail":"Required parameter 'buildingId' is not present.","instance":"/api/v1/alerts"}},"Unknown status":{"description":"Unknown status","value":{"type":"about:blank","title":"Bad Request","status":400,"detail":"Failed to convert 'status' with value: 'CLOSED'","instance":"/api/v1/alerts"}}}}}},"403":{"description":"A resident asked for the alerts of a building that is not in their token","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"Other building":{"description":"Other building","value":{"type":"about:blank","title":"Forbidden","status":403,"detail":"You do not have access to the alerts of building 7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d","instance":"/api/v1/alerts"}}}}}}}}},"/api/v1/alerts/{alertId}":{"get":{"tags":["Alerts"],"summary":"Get an alert","description":"Returns one alert with its instructions. When evacuationRequired is true, the residents must evacuate the building (US16).","operationId":"getAlert","parameters":[{"name":"alertId","in":"path","description":"Identifier of the alert","required":true,"schema":{"type":"string","format":"uuid"},"example":"0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a"}],"responses":{"200":{"description":"The alert","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AlertResponse"},"examples":{"Evacuation alert":{"description":"Evacuation alert","value":{"id":"6f1d2c3b-4a5e-4f6d-8c7b-9a0e1f2d3c4b","buildingId":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d","type":"SEISMIC_RISK","severity":"CRITICAL","status":"OPEN","title":"Seismic risk CRITICAL","message":"Critical structural risk after the seismic event. Evacuate the building now using the nearest evacuation route.","evacuationRequired":true,"riskIndexId":"4d2b8f6e-1a3c-4e5d-9f7b-2c4a6e8d0f13","seismicEventId":"9e8d7c6b-5a4f-4e3d-b2c1-0a9f8e7d6c5b","sensorId":null,"zone":null,"measuredValue":null,"occurredAt":"2026-10-30T14:32:00Z","createdAt":"2026-10-30T14:32:04Z","acknowledgedAt":null,"acknowledgedBy":null,"resolvedAt":null}},"Threshold alert":{"description":"Threshold alert","value":{"id":"2a4c6e8f-0b1d-4f3a-9c5e-7d9f1b3d5f70","buildingId":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d","type":"THRESHOLD_EXCEEDED","severity":"CRITICAL","status":"OPEN","title":"Sensor threshold exceeded","message":"Reading 0.120 in zone FLOOR-3-NORTH reached the critical threshold 0.100 of sensor 5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11.","evacuationRequired":false,"riskIndexId":null,"seismicEventId":null,"sensorId":"5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11","zone":"FLOOR-3-NORTH","measuredValue":0.12,"occurredAt":"2026-10-30T15:10:00Z","createdAt":"2026-10-30T15:10:01Z","acknowledgedAt":null,"acknowledgedBy":null,"resolvedAt":null}}}}}},"403":{"description":"A resident asked for an alert of a building that is not in their token","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"Other building":{"description":"Other building","value":{"type":"about:blank","title":"Forbidden","status":403,"detail":"You do not have access to the alerts of building 7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d","instance":"/api/v1/alerts"}}}}}},"404":{"description":"No alert has that identifier","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"Unknown alert":{"description":"Unknown alert","value":{"type":"about:blank","title":"Not Found","status":404,"detail":"Alert 0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a was not found","instance":"/api/v1/alerts/0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a"}}}}}}}}},"/api/v1/alerts/health":{"get":{"tags":["Health"],"summary":"Check that the service is running","description":"Skeleton endpoint used to verify deployment and gateway routing. It is not a functional endpoint of the bounded context.","operationId":"health","responses":{"200":{"description":"The service is running","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponse"},"examples":{"Service up":{"description":"Service up","value":{"status":"UP","service":"rumi-notification-service"}}}}}}}}}},"components":{"schemas":{"ThresholdRequest":{"type":"object","description":"Alert limits of a sensor","properties":{"buildingId":{"type":"string","format":"uuid","description":"Building where the sensor is installed","example":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d"},"warningValue":{"type":"number","format":"double","description":"A reading at or above this value raises a HIGH alert","example":0.05},"criticalValue":{"type":"number","format":"double","description":"A reading at or above this value raises a CRITICAL alert; it must be greater than the warning value","example":0.1}},"required":["buildingId","criticalValue","warningValue"]},"ThresholdResponse":{"type":"object","description":"Alert limits configured for a sensor","properties":{"sensorId":{"type":"string","format":"uuid","description":"Sensor the threshold applies to","example":"5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11"},"buildingId":{"type":"string","format":"uuid","description":"Building where the sensor is installed","example":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d"},"warningValue":{"type":"number","format":"double","description":"A reading at or above this value raises a HIGH alert","example":0.05},"criticalValue":{"type":"number","format":"double","description":"A reading at or above this value raises a CRITICAL alert","example":0.1},"updatedAt":{"type":"string","format":"date-time","description":"Last change of the limits (UTC)","example":"2026-10-30T15:00:00Z"}}},"ProblemDetail":{"type":"object","properties":{"type":{"type":"string","format":"uri"},"title":{"type":"string"},"status":{"type":"integer","format":"int32"},"detail":{"type":"string"},"instance":{"type":"string","format":"uri"},"properties":{"type":"object","additionalProperties":{}}}},"AlertResponse":{"type":"object","description":"An alert about a building","properties":{"id":{"type":"string","format":"uuid","description":"Identifier generated by the service","example":"0b7e4c2a-9d1f-4e3b-8a6c-5f2d1e0c9b8a"},"buildingId":{"type":"string","format":"uuid","description":"Building the alert is about","example":"7a9b3c1d-2e4f-4b6a-8c0d-1e2f3a4b5c6d"},"type":{"type":"string","description":"SEISMIC_RISK when raised by a risk index, THRESHOLD_EXCEEDED when raised by a reading","enum":["SEISMIC_RISK","THRESHOLD_EXCEEDED"],"example":"SEISMIC_RISK"},"severity":{"type":"string","description":"LOW, MEDIUM, HIGH or CRITICAL","enum":["LOW","MEDIUM","HIGH","CRITICAL"],"example":"CRITICAL"},"status":{"type":"string","description":"OPEN, ACKNOWLEDGED or RESOLVED","enum":["OPEN","ACKNOWLEDGED","RESOLVED"],"example":"OPEN"},"title":{"type":"string","description":"Short title of the alert","example":"Seismic risk CRITICAL"},"message":{"type":"string","description":"Instructions for the residents and the administrator","example":"Critical structural risk after the seismic event. Evacuate the building now using the nearest evacuation route."},"evacuationRequired":{"type":"boolean","description":"True when the residents must evacuate (CRITICAL seismic risk, US16)","example":true},"riskIndexId":{"type":"string","format":"uuid","description":"Risk index of Seismic Correlation that raised the alert; null for threshold alerts","example":"3c9a1e7d-4b2f-4d8e-a6c1-7e5f3b2d1a90"},"seismicEventId":{"type":"string","format":"uuid","description":"Seismic event reported by the IGP; null for threshold alerts","example":"9e8d7c6b-5a4f-4e3d-b2c1-0a9f8e7d6c5b"},"sensorId":{"type":"string","format":"uuid","description":"Sensor whose reading raised the alert; null for seismic risk alerts","example":"5d1c2f0e-8f4a-4a53-9a7e-0f3b1c9d7a11"},"zone":{"type":"string","description":"Zone of the sensor; null for seismic risk alerts","example":"FLOOR-3-NORTH"},"measuredValue":{"type":"number","format":"double","description":"Reading that exceeded the threshold; null for seismic risk alerts","example":0.12},"occurredAt":{"type":"string","format":"date-time","description":"When the risk was calculated or the reading was recorded (UTC)","example":"2026-10-06T14:32:00Z"},"createdAt":{"type":"string","format":"date-time","description":"When the alert was raised (UTC)","example":"2026-10-06T14:32:05Z"},"acknowledgedAt":{"type":"string","format":"date-time","description":"When the alert was acknowledged (UTC)"},"acknowledgedBy":{"type":"string","format":"uuid","description":"User who acknowledged the alert"},"resolvedAt":{"type":"string","format":"date-time","description":"When the alert was resolved (UTC)"}}},"HealthResponse":{"type":"object","description":"Liveness information of the service","properties":{"status":{"type":"string","description":"Liveness status","example":"UP"},"service":{"type":"string","description":"Name of the service","example":"rumi-notification-service"}}}}}}